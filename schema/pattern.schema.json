{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/byjunyoung/doan/schema/pattern.schema.json",
  "title": "doan pattern",
  "description": "How the parts are arranged on this product's screens: the screens it binds, the skeleton of their top-level elements (checked by L29), and the rules a person and an agent read.",
  "type": "object",
  "required": ["pattern", "skeleton"],
  "additionalProperties": false,
  "properties": {
    "pattern": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "description": { "type": "string" },
    "applies_to": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "types": { "$ref": "#/$defs/names" },
        "platforms": { "$ref": "#/$defs/names" },
        "screens": { "$ref": "#/$defs/names" },
        "except": { "$ref": "#/$defs/names" }
      }
    },
    "skeleton": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role"],
        "additionalProperties": false,
        "properties": {
          "role": { "type": "string" },
          "kind": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" }, "minItems": 1 }] },
          "many": { "type": "boolean" },
          "optional": { "type": "boolean" },
          "note": { "type": "string" }
        }
      }
    },
    "notes": { "type": "array", "items": { "type": "string" } },
    "graduated_to": { "type": "string", "description": "the compound component this pattern's part became" }
  },
  "$defs": {
    "names": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] }
  }
}
