{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/byjunyoung/doan/schema/screen.schema.json",
  "title": "Screen file",
  "type": "object",
  "required": [
    "schema",
    "id",
    "screen",
    "section",
    "type",
    "elements"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "enum": [
        "doan/0.2",
        "design-core/0.2"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^scr_[A-Za-z0-9]+$"
    },
    "screen": {
      "type": "string",
      "minLength": 1
    },
    "section": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "platform": {
      "type": "string",
      "minLength": 1
    },
    "refs": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/uri"
      }
    },
    "elements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/element"
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/layoutRule"
      }
    },
    "states": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/patch"
        }
      }
    },
    "variants": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/patch"
          }
        }
      }
    },
    "flows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/flow"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "breakpoints": {
      "type": "object",
      "description": "patches per breakpoint name (conventions.breakpoints), applied last, on top of the state",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/patch"
        }
      }
    },
    "status": {
      "enum": [
        "draft",
        "ready",
        "done"
      ],
      "description": "where the screen is for developers: draft (default), ready — handed off, done — built"
    }
  },
  "$defs": {
    "uri": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9+.-]*:.+"
    },
    "tbd": {
      "type": "object",
      "required": [
        "$tbd"
      ],
      "additionalProperties": false,
      "properties": {
        "$tbd": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "owner": {
              "type": "string"
            },
            "due": {
              "type": "string",
              "format": "date"
            },
            "note": {
              "type": "string"
            }
          }
        }
      }
    },
    "element": {
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/element"
          }
        }
      },
      "additionalProperties": true
    },
    "layoutRule": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "direction": {
          "enum": [
            "row",
            "column"
          ]
        },
        "columns": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "const": "auto"
            },
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          ],
          "description": "a count; auto: as many as fit, each at least `min` wide; or the tracks themselves — \"1fr auto auto\" or [1fr, auto, auto]"
        },
        "gap": {
          "type": "string"
        },
        "padding": {
          "description": "a space token for every side, or [vertical, horizontal] — as Figma's two padding fields and CSS's two values",
          "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": ["string", "number"] }, "minItems": 2, "maxItems": 2 }]
        },
        "align": {
          "type": "string",
          "description": "horizontal: start · center · end · space-between · stretch — whatever the direction"
        },
        "grow": {
          "type": "boolean"
        },
        "size": {
          "type": "string"
        },
        "min": {
          "type": "string",
          "description": "a size class (sm, md, lg) — the least width of an auto column"
        },
        "wrap": {
          "type": "boolean",
          "description": "a stack or row whose children wrap onto the next line when the width runs out"
        },
        "scroll": {
          "enum": [
            "horizontal",
            "vertical"
          ],
          "description": "horizontal: children keep their width and the container scrolls sideways; vertical: a list longer than the frame scrolls inside it"
        },
        "justify": {
          "type": "string",
          "description": "vertical: start · center · end · space-between · stretch — whatever the direction"
        },
        "surface": {
          "type": "string",
          "description": "a surface token group the region wears — surface.page paints a content area the page colour, surface.card a box"
        }
      },
      "additionalProperties": false
    },
    "patch": {
      "type": "object",
      "required": [
        "target"
      ],
      "properties": {
        "target": {
          "type": "string"
        },
        "replace": {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "hide": {
          "const": true
        },
        "set": {
          "type": "object"
        },
        "layout": {
          "$ref": "#/$defs/layoutRule"
        }
      },
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "replace"
          ]
        },
        {
          "required": [
            "hide"
          ]
        },
        {
          "required": [
            "set"
          ]
        },
        {
          "required": [
            "layout"
          ]
        }
      ]
    },
    "flow": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string"
        },
        "via": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "when": {
          "type": "string"
        },
        "style": {
          "enum": [
            "default",
            "conditional"
          ]
        },
        "gesture": {
          "type": "string"
        },
        "nav": {
          "type": "string"
        },
        "in": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          ],
          "description": "the states the flow leaves from — Loading only, say; without it, every state where the element is"
        }
      },
      "additionalProperties": false
    }
  }
}
